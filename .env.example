# ========================================================
# PurchaseGuard - Environment Configuration Template
# ========================================================

# App
NEXT_PUBLIC_APP_URL="https://purchaseguard.app"
NEXT_PUBLIC_APP_NAME="PurchaseGuard"
NODE_ENV="development"

# Supabase (Auth, Postgres DB, Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_DB_PASSWORD="your-secure-db-password"

# Stripe (Billing, Checkout, Webhooks, Tax)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PLUS_MONTHLY="price_..."
STRIPE_PRICE_PLUS_ANNUAL="price_..."

# Security & Encryption (AES-256-GCM field-level token encryption)
# Generate with: openssl rand -hex 32 (Must be 64 hex characters / 32 bytes)
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Email OAuth (Minimum Read-Only Scopes)
# Google OAuth: https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://purchaseguard.app/api/auth/oauth/google/callback"

# Microsoft Graph OAuth: Mail.Read, offline_access
MICROSOFT_CLIENT_ID="your-azure-app-client-id"
MICROSOFT_CLIENT_SECRET="your-azure-app-client-secret"
MICROSOFT_REDIRECT_URI="https://purchaseguard.app/api/auth/oauth/microsoft/callback"

# Transactional Email (Resend / Postmark)
RESEND_API_KEY="re_..."
EMAIL_FROM_ADDRESS="PurchaseGuard <notifications@purchaseguard.app>"
RECEIPTS_INBOUND_EMAIL="receipts@purchaseguard.app"

# Carrier Package Tracking (AfterShip or Shippo API)
AFTERSHIP_API_KEY="asat_..."

# AI Extraction (LLM with structured JSON output for unknown retailers)
OPENAI_API_KEY="sk-..."

# Monitoring & Analytics (Sentry)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
